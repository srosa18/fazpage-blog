---
const { pillar = "P1" } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---
<svg viewBox="0 0 1200 620" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Capa do artigo">
  <defs>
    <radialGradient id={`glow-${uid}`} cx="64%" cy="40%" r="62%">
      <stop offset="0%" stop-color="#A8FF3E" stop-opacity="0.30"></stop>
      <stop offset="55%" stop-color="#A8FF3E" stop-opacity="0.06"></stop>
      <stop offset="100%" stop-color="#A8FF3E" stop-opacity="0"></stop>
    </radialGradient>
    <filter id={`soft-${uid}`} x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6"></feGaussianBlur>
    </filter>
  </defs>

  <rect width="1200" height="620" fill="#10120a"></rect>
  <rect width="1200" height="620" fill={`url(#glow-${uid})`}></rect>
  <g stroke="#222717" stroke-width="1">
    <line x1="0" y1="150" x2="1200" y2="150"></line>
    <line x1="0" y1="470" x2="1200" y2="470"></line>
    <line x1="300" y1="0" x2="300" y2="620"></line>
    <line x1="900" y1="0" x2="900" y2="620"></line>
  </g>

  {pillar === "P1" && (
    <g>
      <g fill="none" stroke="#A8FF3E">
        <circle cx="800" cy="310" r="250" stroke-width="1.4" opacity="0.18"></circle>
        <circle cx="800" cy="310" r="185" stroke-width="1.6" opacity="0.35"></circle>
        <circle cx="800" cy="310" r="120" stroke-width="2" opacity="0.6"></circle>
      </g>
      <circle cx="800" cy="310" r="120" fill="#A8FF3E" opacity="0.12"></circle>
      <circle cx="800" cy="310" r="62" fill="#A8FF3E"></circle>
      <circle cx="610" cy="180" r="9" fill="#A8FF3E" opacity="0.8"></circle>
      <circle cx="1010" cy="430" r="14" fill="#A8FF3E" opacity="0.5"></circle>
      <circle cx="980" cy="190" r="6" fill="#A8FF3E" opacity="0.6"></circle>
    </g>
  )}

  {pillar === "P2" && (
    <g>
      <rect x="540" y="150" width="520" height="320" rx="6" fill="none" stroke="#A8FF3E" stroke-width="1.4" opacity="0.25"></rect>
      <rect x="620" y="205" width="360" height="210" rx="6" fill="#A8FF3E" opacity="0.10"></rect>
      <rect x="620" y="205" width="360" height="210" rx="6" fill="none" stroke="#A8FF3E" stroke-width="1.8" opacity="0.5"></rect>
      <rect x="720" y="265" width="160" height="90" rx="4" fill="#A8FF3E"></rect>
      <circle cx="585" cy="180" r="8" fill="#A8FF3E" opacity="0.7"></circle>
      <circle cx="1015" cy="440" r="12" fill="#A8FF3E" opacity="0.5"></circle>
    </g>
  )}

  {pillar === "P3" && (
    <g>
      <line x1="690" y1="310" x2="910" y2="310" stroke="#A8FF3E" stroke-width="2" stroke-dasharray="4 12" opacity="0.5"></line>
      <g fill="none" stroke="#A8FF3E">
        <circle cx="690" cy="310" r="110" stroke-width="1.4" opacity="0.25"></circle>
        <circle cx="910" cy="310" r="110" stroke-width="1.4" opacity="0.25"></circle>
        <circle cx="690" cy="310" r="60" stroke-width="2" opacity="0.55"></circle>
        <circle cx="910" cy="310" r="60" stroke-width="2" opacity="0.55"></circle>
      </g>
      <circle cx="690" cy="310" r="46" fill="#A8FF3E"></circle>
      <circle cx="910" cy="310" r="30" fill="#A8FF3E" opacity="0.45"></circle>
      <circle cx="560" cy="200" r="8" fill="#A8FF3E" opacity="0.6"></circle>
      <circle cx="1030" cy="420" r="12" fill="#A8FF3E" opacity="0.5"></circle>
    </g>
  )}

  {pillar === "P4" && (
    <g>
      <g stroke="#A8FF3E" stroke-width="1.4" opacity="0.3">
        <line x1="560" y1="120" x2="560" y2="500"></line>
        <line x1="660" y1="120" x2="660" y2="500"></line>
        <line x1="760" y1="120" x2="760" y2="500"></line>
        <line x1="860" y1="120" x2="860" y2="500"></line>
        <line x1="960" y1="120" x2="960" y2="500"></line>
        <line x1="1060" y1="120" x2="1060" y2="500"></line>
      </g>
      <rect x="710" y="240" width="200" height="140" fill="#A8FF3E" opacity="0.14"></rect>
      <rect x="710" y="240" width="200" height="140" fill="none" stroke="#A8FF3E" stroke-width="2.2"></rect>
      <rect x="770" y="288" width="80" height="44" fill="#A8FF3E"></rect>
    </g>
  )}

  {pillar === "P5" && (
    <g>
      <g stroke="#A8FF3E" stroke-width="1.6" opacity="0.32">
        <line x1="520" y1="510" x2="900" y2="120"></line>
        <line x1="640" y1="510" x2="1020" y2="120"></line>
        <line x1="760" y1="510" x2="1140" y2="120"></line>
      </g>
      <circle cx="820" cy="310" r="120" fill="#A8FF3E" opacity="0.10"></circle>
      <circle cx="820" cy="310" r="64" fill="#A8FF3E"></circle>
      <circle cx="610" cy="200" r="9" fill="#A8FF3E" opacity="0.7"></circle>
      <circle cx="1020" cy="430" r="13" fill="#A8FF3E" opacity="0.5"></circle>
    </g>
  )}
</svg>
