---
const { pillar = "P1" } = Astro.props;
---
<svg viewBox="0 0 1200 620" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Capa do artigo">
  <rect width="1200" height="620" fill="#14160d"></rect>
  <g stroke="#2c331c" stroke-width="1">
    <line x1="0" y1="160" x2="1200" y2="160"></line>
    <line x1="0" y1="460" x2="1200" y2="460"></line>
    <line x1="300" y1="0" x2="300" y2="620"></line>
  </g>

  {pillar === "P1" && (
    <g>
      <g fill="none" stroke="#A8FF3E" stroke-width="1.2">
        <circle cx="860" cy="310" r="70" opacity="0.9"></circle>
        <circle cx="860" cy="310" r="140" opacity="0.5"></circle>
        <circle cx="860" cy="310" r="215" opacity="0.28"></circle>
        <circle cx="860" cy="310" r="295" opacity="0.16"></circle>
        <circle cx="860" cy="310" r="380" opacity="0.09"></circle>
      </g>
      <circle cx="860" cy="310" r="30" fill="#A8FF3E"></circle>
    </g>
  )}

  {pillar === "P2" && (
    <g>
      <g fill="none" stroke="#A8FF3E">
        <rect x="600" y="150" width="440" height="320" stroke-width="1.2" opacity="0.5"></rect>
        <rect x="680" y="210" width="280" height="200" stroke-width="1.2" opacity="0.32"></rect>
        <rect x="760" y="270" width="120" height="80" stroke-width="1.2" opacity="0.6"></rect>
      </g>
      <circle cx="820" cy="310" r="26" fill="#A8FF3E"></circle>
    </g>
  )}

  {pillar === "P3" && (
    <g>
      <g fill="none" stroke="#A8FF3E" stroke-width="1.2">
        <circle cx="760" cy="310" r="60" opacity="0.85"></circle>
        <circle cx="960" cy="310" r="60" opacity="0.85"></circle>
        <circle cx="760" cy="310" r="120" opacity="0.3"></circle>
        <circle cx="960" cy="310" r="120" opacity="0.3"></circle>
      </g>
      <circle cx="760" cy="310" r="20" fill="#A8FF3E"></circle>
      <circle cx="960" cy="310" r="20" fill="#2f3a16"></circle>
    </g>
  )}

  {pillar === "P4" && (
    <g stroke="#A8FF3E" stroke-width="1.2" fill="none">
      <g opacity="0.35">
        <line x1="560" y1="120" x2="560" y2="500"></line>
        <line x1="650" y1="120" x2="650" y2="500"></line>
        <line x1="740" y1="120" x2="740" y2="500"></line>
        <line x1="830" y1="120" x2="830" y2="500"></line>
        <line x1="920" y1="120" x2="920" y2="500"></line>
        <line x1="1010" y1="120" x2="1010" y2="500"></line>
      </g>
      <rect x="740" y="250" width="180" height="120" stroke-width="1.6" opacity="0.9"></rect>
    </g>
  )}

  {pillar === "P5" && (
    <g stroke="#A8FF3E" fill="none">
      <g opacity="0.3" stroke-width="1.2">
        <line x1="540" y1="500" x2="900" y2="120"></line>
        <line x1="640" y1="500" x2="1000" y2="120"></line>
        <line x1="740" y1="500" x2="1100" y2="120"></line>
      </g>
      <circle cx="820" cy="310" r="30" fill="#A8FF3E" stroke="none"></circle>
    </g>
  )}
</svg>
