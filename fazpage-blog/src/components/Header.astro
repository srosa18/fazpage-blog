---
---
<header>
  <nav class="nav">
    <a href="/" aria-label="FazPage Blog"><img class="logo-img" src="/logo.svg" alt="FazPage" /></a>
    <div class="menu">
      <a href="/" class="active nav-articles">Artigos</a>
      <a href="/sobre/" class="nav-link-sobre">Sobre</a>
      <a class="pill" href="https://fazpage.com.br" target="_blank" rel="noopener">fazpage.com.br</a>
      <button class="hamb" type="button" aria-label="Abrir menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
  <nav class="mobile-menu" aria-label="Menu do site" hidden>
    <a href="/">Artigos</a>
    <a href="/sobre/">Sobre</a>
  </nav>
</header>
<script is:inline>
  (function () {
    var h = document.querySelector('.hamb');
    var m = document.querySelector('.mobile-menu');
    if (!h || !m) return;
    h.addEventListener('click', function () {
      var hidden = m.hasAttribute('hidden');
      if (hidden) { m.removeAttribute('hidden'); h.classList.add('on'); h.setAttribute('aria-expanded', 'true'); }
      else { m.setAttribute('hidden', ''); h.classList.remove('on'); h.setAttribute('aria-expanded', 'false'); }
    });
  })();
</script>
