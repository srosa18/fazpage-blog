---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts[0];
const rest = posts.slice(1);
const fmt = (d) => d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
---
<Base title={undefined} description="Design, sites, conversão e CRM explicados em português de gente, para quem empreende.">
  <section class="home-head col">
    <span class="kick">Blog da FazPage</span>
    <h1 class="hero-h1" style="max-width:26ch">Seu site é a sua vitrine.<br />E pode ser o seu<br />melhor vendedor.</h1>
    <p>O nosso compromisso aqui é ter uma conversa de dono pra dono sobre marketing digital. Ideias práticas pra vender mais na internet, atender melhor o cliente e fazer seu site trabalhar pelo seu negócio.</p>
  </section>

  {featured && (
    <a href={`/blog/${featured.id}/`}>
      <div class="cover home-cover" style="margin-top:24px"><img src="/IMAGENS/index-fazpage.png" alt="" style="width:100%;height:100%;object-fit:cover" /></div>
      <section class="feat col">
        <div class="ft-meta">{featured.data.pillarLabel} · {fmt(featured.data.pubDate)}</div>
        <h2>{featured.data.title}</h2>
        <p class="ft-sub">{featured.data.description}</p>
        <span class="more">Ler o artigo →</span>
      </section>
    </a>
  )}

  {rest.length > 0 && (
    <section class="wide" style="margin-top:64px">
      <div class="section-h">Mais artigos</div>
      <div class="grid">
        {rest.map((post) => (
          <a class="card" href={`/blog/${post.id}/`}>
            <div class="cov">{post.data.cover ? <img src={post.data.cover} alt="" style="width:100%;height:100%;object-fit:cover" /> : <Cover pillar={post.data.pillar} />}</div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="foot"><span>{fmt(post.data.pubDate)}</span><span class="more">Ler mais →</span></div>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
