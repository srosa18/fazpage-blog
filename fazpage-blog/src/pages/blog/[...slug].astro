---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d) => d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
const pageUrl = new URL(`/blog/${post.id}/`, Astro.site).href;

const all = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---
<Base title={post.data.title} description={post.data.description}>
  <div class="art-head read">
    <span class="kick">{post.data.pillarLabel}</span>
    <h1>{post.data.title}</h1>
    <div class="meta">
      <span>Por {post.data.author} · {fmt(post.data.pubDate)}</span>
      <span class="share" data-title={post.data.title}>Compartilhar:&nbsp; <a class="sh-x" href="#" target="_blank" rel="noopener">X</a>&nbsp; ·&nbsp; <a class="sh-li" href="#" target="_blank" rel="noopener">LinkedIn</a>&nbsp; ·&nbsp; <button type="button" class="sh-copy">Copiar link</button></span>
    </div>
  </div>

  <div class="cover" style="margin-top:44px">{post.data.cover ? <img src={post.data.cover} alt="" style="width:100%;height:100%;object-fit:cover" /> : <Cover pillar={post.data.pillar} />}</div>

  <article class="prose read">
    <Content />
    <a class="back" href="/">← Voltar para os artigos</a>
  </article>

  <script is:inline>
    (function () {
      var box = document.querySelector('.share');
      if (!box) return;
      var url = location.href;
      var title = box.getAttribute('data-title') || document.title;
      var x = box.querySelector('.sh-x');
      if (x) x.href = 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(title);
      var li = box.querySelector('.sh-li');
      if (li) li.href = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(url);
      var cp = box.querySelector('.sh-copy');
      if (cp) cp.addEventListener('click', function () {
        navigator.clipboard.writeText(url).then(function () {
          var old = cp.textContent;
          cp.textContent = 'Link copiado!';
          setTimeout(function () { cp.textContent = old; }, 1800);
        });
      });
    })();
  </script>

  <section class="comments read">
    <h2 class="cmt-h">Comentários</h2>
    <div id="cusdis_thread"
      data-host="https://cusdis.com"
      data-app-id="830e57f1-c1a2-4a67-a38d-0a17cc951496"
      data-page-id={post.id}
      data-page-url={pageUrl}
      data-page-title={post.data.title}>
    </div>
    <script async defer src="https://cusdis.com/js/cusdis.es.js"></script>
  </section>

  {all.length > 0 && (
    <section class="related wide">
      <div class="section-h">Continue lendo</div>
      <div class="grid">
        {all.map((p) => (
          <a class="card" href={`/blog/${p.id}/`}>
            <div class="cov">{p.data.cover ? <img src={p.data.cover} alt="" style="width:100%;height:100%;object-fit:cover" /> : <Cover pillar={p.data.pillar} />}</div>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
            <div class="foot"><span>{fmt(p.data.pubDate)}</span><span class="more">Ler mais →</span></div>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
